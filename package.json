{
  "name": "@local/dsh-moyutang",
  "version": "1.3.0",
  "private": true,
  "description": "摸鱼塘：把 Agent 消耗的 Token 变成鱼饵积分，在侧边栏钓鱼、集图鉴、换金币。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/fish/*.webp",
    "assets/items/*.webp",
    "assets/ponds/*.webp",
    "README.md",
    "INSTALL.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "license": "MIT"
}
